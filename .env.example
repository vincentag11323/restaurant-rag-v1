# Copy to .env and fill in. Never commit .env.
PORT=3000
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=guest_profiles
INVOICES_CSV=data/mock/invoices.csv
# Optional: without a key, campaigns run in dry-run mode (audience + prompt, no copy).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_TIMEOUT_MS=20000
# Standalone chat frontend (npm run frontend)
FRONTEND_PORT=3001
RAG_API_URL=http://localhost:3000
