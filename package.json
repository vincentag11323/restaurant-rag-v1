{
  "name": "restaurant-rag",
  "version": "1.0.0",
  "description": "ResortOS Module 1 - VIP Guest & Seasonal Marketing RAG (LangChain.js + ChromaDB)",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "chroma": "chroma run --path ./chroma-data --port 8000",
    "ingest": "tsx --env-file-if-exists=.env src/scripts/ingest.ts",
    "eval:ranking": "tsx --env-file-if-exists=.env src/scripts/eval-ranking.ts",
    "frontend": "tsx watch --env-file-if-exists=.env src/frontend/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincentag11323/restaurant-rag.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/vincentag11323/restaurant-rag/issues"
  },
  "homepage": "https://github.com/vincentag11323/restaurant-rag#readme",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@huggingface/transformers": "^3.8.1",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.3.0",
    "@langchain/deepseek": "^1.1.19",
    "chromadb": "^3.5.0",
    "csv-parse": "^7.0.3",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
